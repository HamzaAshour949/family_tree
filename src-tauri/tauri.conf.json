{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Tree Studio",
  "version": "0.1.0",
  "identifier": "com.hamzaashour.family-tree-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Family Tree Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* http://[::1]:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNEY5QjgzMkFDQTUwOApSV1FJcGF3eXVQa2tCRHpncFUvK2xDM3pYNUVVcDRvOTlKemN3bk9PQlZhcHEvR2VDRmI3bTZzdQo=",
      "endpoints": [
        "http://127.0.0.1:8080/api/update.php?target={{target}}&arch={{arch}}&current={{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}