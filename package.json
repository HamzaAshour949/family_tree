{
  "name": "family-tree-studio",
  "productName": "Family Tree Studio",
  "desktopName": "family-tree-studio.desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-platform desktop workspace for building, editing and exporting family trees",
  "author": "Hamza Ashour",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-shell.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:all": "npm run build && electron-builder --mac --win",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "zustand": "^5.0.12"
  }
}
